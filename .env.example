# ==============================================================================
# Email Organizer — Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# Do NOT commit your actual '.env' file to version control.
# ==============================================================================

# Google Gemini API Key (Required for email classification and draft generation)
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Safety execution switch (true/false)
# true  = Shadow Mode. Logs all pipeline outcomes to audit_log.csv, does not mutate Gmail.
# false = Live Mode. Enables writing draft replies, labeling, and moving emails in Gmail.
DRY_RUN=true

# (Optional) Other LLM provider keys if configured in config/models.yaml:
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# DASHSCOPE_API_KEY=your_qwen_dashscope_api_key_here
